@page "/ai-model"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>AI Model</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (data == null)
{
    <p class="text-muted">Loading...</p>
}
else
{
    <div class="row">
        <div class="col-md-2">
            <div class="card card-default" style="height:100%;">
                <div class="card-header"><h2>Model Setup</h2></div>
                <div class="card-body">
                    @NumField("gMaxIter", "Max. # of Iterations", data.GMaxIter, "gen-info")
                    @NumField("gConvTol", "Convergence Tolerance", data.GConvTol, "gen-info")
                    @NumField("gLearnRate", "Learning Rate", data.GLearnRate, "gen-info")
                    @NumField("gStepSizeMin", "Min Step Size", data.GStepSizeMin, "gen-info")
                    @NumField("gnHiddenLayers", "# of Hidden Layers", data.GnHiddenLayers, "gen-info")

                    <div class="form-floating mb-2">
                        <select class="form-select" disabled="@isBusy" @bind:get="data.GHLayerType" @bind:set="OnHLayerTypeChanged">
                            <option value="Tanh">Tanh</option>
                            <option value="ReLu">ReLu</option>
                        </select>
                        <label>Activation Function</label>
                    </div>

                    @DisabledField("# Neurons - Input Layer", data.GInputNeurons)
                    @DisabledField("# Neurons - Output Layer", data.GOutputNeurons)

                    <table class="table table-sm mt-2">
                        <thead><tr><th>Layer #</th><th>Description</th><th># of Neurons</th></tr></thead>
                        <tbody>
                            @foreach (var row in data.NeuronRows)
                            {
                                <tr>
                                    <td>@row.LayerNo</td>
                                    <td>@row.Description</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" value="@row.NeuronCount" disabled="@isBusy"
                                               @onchange="e => OnNeuronCountChanged(row.LayerNo - 1, e.Value?.ToString())" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @DisabledField("Coefficient of Determination (%)", data.GRMS)

                    <button type="button" class="btn btn-primary w-100 mt-2" disabled="@isBusy" @onclick="OnTrain">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Train Model
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-10">
            <div class="card card-default mb-2">
                <div class="card-header"><h2>Model Details</h2></div>
                <div class="card-body">
                    <div class="form-floating mb-2" style="max-width:300px;">
                        <select class="form-select" disabled="@isBusy" @bind:get="data.LayerSelectedIndex" @bind:set="OnLayerChanged">
                            @for (int i = 0; i < data.LayerOptions.Count; i++)
                            {
                                <option value="@i">@data.LayerOptions[i]</option>
                            }
                        </select>
                        <label>Weight Functions for the Hidden Layer</label>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    @foreach (var col in data.WeightColumns)
                                    {
                                        <th>@col</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in data.WeightRows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td>@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header"><h2>Predicted vs. Actual</h2></div>
                <div class="card-body">
                    <canvas id="aiModelChart"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private AiModelViewDto? data;
    private string? errorMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync() => await LoadData();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && data != null) await RenderChart();
    }

    private async Task LoadData()
    {
        try
        {
            isBusy = true;
            var response = await Http.GetFromJsonAsync<ApiResp<AiModelViewDto>>("AIModel/data");
            if (response?.Success == true && response.Data != null)
                data = response.Data;
            else
                errorMessage = response?.Error ?? "Failed to load AI Model data.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnFieldChanged(string name, string? value, string endpoint)
    {
        if (isBusy) return;
        await Post($"AIModel/{endpoint}", new FieldRequest { Name = name, Value = value });
    }

    private async Task OnHLayerTypeChanged(string value)
    {
        if (isBusy) return;
        await Post("AIModel/hlayer-type-changed", new FieldRequest { Name = "gHLayerType", Value = value });
    }

    private async Task OnNeuronCountChanged(int rowId, string? value)
    {
        if (isBusy) return;
        await Post("AIModel/node-editing", new NodeEditRequest { RowId = rowId, ColId = 2, Text = value });
    }

    private async Task OnLayerChanged(int index)
    {
        if (isBusy) return;
        await Post("AIModel/layer-changed", new LayerRequest { Index = index });
    }

    private async Task OnTrain()
    {
        if (isBusy) return;
        await Post<object>("AIModel/train", new { });
    }

    private async Task Post<TReq>(string url, TReq body)
    {
        try
        {
            isBusy = true;
            var response = await Http.PostAsJsonAsync(url, body);
            var result = await response.Content.ReadFromJsonAsync<ApiResp<AiModelViewDto>>();
            if (result?.Success == true && result.Data != null)
            {
                data = result.Data;
                await RenderChart();
            }
            else
            {
                errorMessage = result?.Error ?? "Update failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Update error: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RenderChart()
    {
        if (data == null) return;
        await JS.InvokeVoidAsync("renderAiModelChart", "aiModelChart", data.YY, data.YYP, data.YTh, data.ChartBottomTitle, data.ChartLeftTitle);
    }

    private RenderFragment NumField(string name, string label, string value, string endpoint) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "form-floating mb-2");
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "number");
        builder.AddAttribute(seq++, "class", "form-control");
        builder.AddAttribute(seq++, "id", name);
        builder.AddAttribute(seq++, "value", value);
        builder.AddAttribute(seq++, "disabled", isBusy);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => OnFieldChanged(name, e.Value?.ToString(), endpoint)));
        builder.CloseElement();
        builder.OpenElement(seq++, "label"); builder.AddAttribute(seq++, "for", name); builder.AddContent(seq++, label); builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment DisabledField(string label, string value) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "form-floating mb-2");
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "text");
        builder.AddAttribute(seq++, "class", "form-control");
        builder.AddAttribute(seq++, "value", value);
        builder.AddAttribute(seq++, "disabled", true);
        builder.CloseElement();
        builder.OpenElement(seq++, "label"); builder.AddContent(seq++, label); builder.CloseElement();
        builder.CloseElement();
    };

    public class ApiResp<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public string? Error { get; set; }
    }

    public class FieldRequest { public string Name { get; set; } = string.Empty; public string? Value { get; set; } }
    public class NodeEditRequest { public int RowId { get; set; } public int ColId { get; set; } public string? Text { get; set; } }
    public class LayerRequest { public int Index { get; set; } }

    public class AiModelViewDto
    {
        public string GMaxIter { get; set; } = string.Empty;
        public string GConvTol { get; set; } = string.Empty;
        public string GLearnRate { get; set; } = string.Empty;
        public string GStepSizeMin { get; set; } = string.Empty;
        public string GnHiddenLayers { get; set; } = string.Empty;
        public string GHLayerType { get; set; } = string.Empty;
        public string GRMS { get; set; } = string.Empty;
        public string GInputNeurons { get; set; } = string.Empty;
        public string GOutputNeurons { get; set; } = string.Empty;

        public List<NeuronRowDto> NeuronRows { get; set; } = new();
        public List<string> WeightColumns { get; set; } = new();
        public List<List<string>> WeightRows { get; set; } = new();

        public List<string> LayerOptions { get; set; } = new();
        public int LayerSelectedIndex { get; set; }

        public double[] YY { get; set; } = Array.Empty<double>();
        public double[] YYP { get; set; } = Array.Empty<double>();
        public double[] YTh { get; set; } = Array.Empty<double>();
        public string ChartBottomTitle { get; set; } = string.Empty;
        public string ChartLeftTitle { get; set; } = string.Empty;
    }

    public class NeuronRowDto
    {
        public int LayerNo { get; set; }
        public string Description { get; set; } = string.Empty;
        public int NeuronCount { get; set; }
    }
}
